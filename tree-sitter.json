{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "logrotate",
      "camelcase": "Logrotate",
      "title": "Logrotate",
      "scope": "source.logrotate",
      "file-types": [
        "logrotate.conf",
        "logrotate"
      ],
      "injection-regex": "^logrotate$",
      "class-name": "TreeSitterLogrotate"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Logrotate configuration grammar for Tree-sitter",
    "authors": [
      {
        "name": "Brandon Williams",
        "email": "willibrandon@gmail.com",
        "url": "https://github.com/willibrandon"
      }
    ],
    "links": {
      "repository": "https://github.com/willibrandon/tree-sitter-logrotate"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": true
  }
}
