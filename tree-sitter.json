{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "logrotate",
      "camelcase": "Logrotate",
      "title": "Logrotate",
      "scope": "source.logrotate",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "file-types": [
        "logrotate.conf",
        "logrotate"
      ],
      "injection-regex": "^logrotate$",
      "class-name": "TreeSitterLogrotate"
    },
    {
      "name": "logrotate_state",
      "camelcase": "LogrotateState",
      "title": "Logrotate State",
      "scope": "source.logrotate.state",
      "path": "src/state",
      "highlights": "src/state/queries/highlights.scm",
      "file-types": [
        "logrotate.status"
      ],
      "first-line-regex": "^logrotate state -- version [12]$",
      "injection-regex": "^logrotate[-_ ]state$",
      "class-name": "TreeSitterLogrotateState"
    }
  ],
  "metadata": {
    "version": "0.1.3",
    "license": "MIT",
    "description": "Logrotate configuration grammar for Tree-sitter",
    "authors": [
      {
        "name": "Brandon Williams",
        "url": "https://github.com/willibrandon"
      }
    ],
    "links": {
      "repository": "https://github.com/willibrandon/tree-sitter-logrotate"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": true
  }
}
