{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "logrotate_state",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "header"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_newline"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "record"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "invalid_record"
                      }
                    ]
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "header": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "keyword",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "logrotate state -- version"
            },
            "named": true,
            "value": "header_keyword"
          }
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "version",
          "content": {
            "type": "SYMBOL",
            "name": "version"
          }
        }
      ]
    },
    "version": {
      "type": "PATTERN",
      "value": "[12]"
    },
    "record": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "path",
          "content": {
            "type": "SYMBOL",
            "name": "quoted_path"
          }
        },
        {
          "type": "PATTERN",
          "value": "[\\t ]+"
        },
        {
          "type": "FIELD",
          "name": "timestamp",
          "content": {
            "type": "SYMBOL",
            "name": "timestamp"
          }
        }
      ]
    },
    "quoted_path": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "escape_sequence"
              },
              {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PATTERN",
                  "value": "[^\"\\\\\\r\\n]+"
                }
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "escape_sequence": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\\\[^\\r\\n]"
      }
    },
    "timestamp": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "year",
          "content": {
            "type": "SYMBOL",
            "name": "year"
          }
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "FIELD",
          "name": "month",
          "content": {
            "type": "SYMBOL",
            "name": "month"
          }
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "FIELD",
          "name": "day",
          "content": {
            "type": "SYMBOL",
            "name": "day"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "-"
                },
                {
                  "type": "FIELD",
                  "name": "hour",
                  "content": {
                    "type": "SYMBOL",
                    "name": "hour"
                  }
                },
                {
                  "type": "STRING",
                  "value": ":"
                },
                {
                  "type": "FIELD",
                  "name": "minute",
                  "content": {
                    "type": "SYMBOL",
                    "name": "minute"
                  }
                },
                {
                  "type": "STRING",
                  "value": ":"
                },
                {
                  "type": "FIELD",
                  "name": "second",
                  "content": {
                    "type": "SYMBOL",
                    "name": "second"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "year": {
      "type": "PATTERN",
      "value": "[+-]?\\d+"
    },
    "month": {
      "type": "PATTERN",
      "value": "[+-]?\\d+"
    },
    "day": {
      "type": "PATTERN",
      "value": "[+-]?\\d+"
    },
    "hour": {
      "type": "PATTERN",
      "value": "[+-]?\\d+"
    },
    "minute": {
      "type": "PATTERN",
      "value": "[+-]?\\d+"
    },
    "second": {
      "type": "PATTERN",
      "value": "[+-]?\\d+"
    },
    "invalid_record": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]+"
        }
      }
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}